         <gmd:lineage>
            <gmd:LI_Lineage>
               <gmd:statement>
                  <gco:CharacterString>La couche d'Occupation du Sol à Grande Echelle (OCS GE) est élaborée à partir de données vecteur existantes et par photo-interprétation d’ortho-images couleurs et proche infrarouge fausses couleurs de la BD ORTHO® ou de l'ORTHO EXPRESS. Le référentiel est compatible en géométrie avec des données socles comme la BD ORTHO® ou la BD TOPO®. La couche définissant la Zone Construite est obtenue par calcul à partir des données d'Occupation du Sol.</gco:CharacterString>
               </gmd:statement>
               <gmd:processStep>
                  <gmd:LI_ProcessStep>
                     <gmd:description>
                        <gco:CharacterString>Mise en cohérence par traitements automatiques des données issues des différentes sources dans une seule couche avec renseignements des attributs de la BD OCS GE</gco:CharacterString>
                     </gmd:description>
                     <gmd:rationale>
                        <gco:CharacterString>production</gco:CharacterString>
                     </gmd:rationale>
                  </gmd:LI_ProcessStep>
               </gmd:processStep>
               <gmd:processStep>
                  <gmd:LI_ProcessStep>
                     <gmd:description>
                        <gco:CharacterString>Photo-interprétation à partir des données préparées, à l'aide de l'orthophoto source.</gco:CharacterString>
                     </gmd:description>
                     <gmd:rationale>
                        <gco:CharacterString>production</gco:CharacterString>
                     </gmd:rationale>
                  </gmd:LI_ProcessStep>
               </gmd:processStep>
               <gmd:processStep>
                  <gmd:LI_ProcessStep>
                     <gmd:description>
                        <gco:CharacterString>Calcul de la couche ZONE_CONSTRUITE à partir de la couche OCCUPATION_SOL.</gco:CharacterString>
                     </gmd:description>
                     <gmd:rationale>
                        <gco:CharacterString>production</gco:CharacterString>
                     </gmd:rationale>
                  </gmd:LI_ProcessStep>
               </gmd:processStep>
               <gmd:source>
                  <gmd:LI_Source>
                     <gmd:description>
                        <gco:CharacterString>Référence image de la photo-interprétation : Ortho Express 2023. Les données OCSGE doivent correspondre à cette référence.</gco:CharacterString>
                     </gmd:description>
                  </gmd:LI_Source>
               </gmd:source>
               <gmd:source>
                  <gmd:LI_Source>
                     <gmd:description>
                        <gco:CharacterString>La composante topographique du RGE de l'IGN - la BDTOPO 2023 est utilisée pour constituer la couche OCS GE avant photo-interprétation.</gco:CharacterString>
                     </gmd:description>
                  </gmd:LI_Source>
               </gmd:source>
               <gmd:source>
                  <gmd:LI_Source>
                     <gmd:description>
