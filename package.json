{
  "name": "endless-earth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "endlessEarth": {
    "missionReport": "docs/mission-14.md"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "geo:fetch": "node scripts/fetch-angles.mjs",
    "geo:prepare": "node scripts/prepare-earth.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:build-identity": "node scripts/browser-build-identity.mjs",
    "test:architecture": "node scripts/browser-architecture.mjs after",
    "geo:roads": "node scripts/prepare-road-surface.mjs",
    "geo:road-materials": "node scripts/prepare-road-edges.mjs",
    "test:road-materials": "node scripts/browser-road-materials.mjs after",
    "test:road-optimization": "node scripts/browser-road-performance.mjs 073",
    "test:road-optimization:motion": "node scripts/browser-road-optimization-motion.mjs 073",
    "test:road-optimization:walk": "node scripts/browser-road-optimization-walk.mjs",
    "bench:roads": "node scripts/benchmark-road-optimization.mjs",
    "test:landscape": "node scripts/browser-landscape.mjs after",
    "geo:decorations": "node scripts/prepare-decorations.mjs",
    "test:earthlife": "node scripts/browser-earthlife.mjs after",
    "audio:prepare": "python scripts/prepare-audio-immersive.py",
    "test:audio": "node --test tests/audio.test.mjs tests/audio-immersive.test.mjs",
    "test:audio:browser": "node scripts/browser-audio-immersive-runtime.mjs && AUDIO_EVIDENCE_DIR=docs/mission-11-evidence/audio node scripts/browser-audio-spatial.mjs",
    "bench:audio": "node scripts/benchmark-audio-immersive.mjs",
    "test:audio:soak": "node scripts/browser-audio-soak-101.mjs",
    "test:atmosphere": "node --test tests/atmosphere.test.mjs",
    "test:atmosphere:browser": "node scripts/browser-atmosphere-controls.mjs",
    "audio:prepare:10-1": "python scripts/prepare-audio-naturalist.py",
    "audio:evidence": "node scripts/browser-audio-immersive.mjs before && node scripts/browser-audio-immersive.mjs after",
    "test:coherence": "node --test tests/coherence.test.mjs",
    "test:coherence:browser": "node scripts/browser-coherence.mjs after && node scripts/browser-coherence-runtime.mjs && node scripts/browser-coherence-camera.mjs && node scripts/browser-coherence-gallery.mjs",
    "coherence:evidence": "node scripts/browser-coherence.mjs before && node scripts/browser-coherence.mjs after && node scripts/browser-coherence.mjs record",
    "test:immersive": "node --test tests/optimization.test.mjs && node scripts/browser-immersive-runtime.mjs && node scripts/browser-immersive-missing.mjs && node scripts/browser-immersive-checks.mjs",
    "test:immersive:visibility": "node scripts/browser-immersive-visibility.mjs",
    "test:immersive:soak": "node scripts/browser-immersive-soak.mjs",
    "bench:immersive": "node scripts/benchmark-immersive.mjs && node scripts/browser-immersive-timers.mjs",
    "report:immersive": "python scripts/report-immersive.py && python scripts/report-immersive-audio.py",
    "geo:surface-art": "python scripts/prepare-surface-rock.py && node scripts/prepare-surface-art.mjs",
    "test:surface-art": "node scripts/browser-surface-art.mjs after",
    "geo:architecture-art": "node scripts/prepare-architecture-atlas.mjs && DECORATION_EVIDENCE_DIR=work/mission-12B/preparation node scripts/prepare-decorations.mjs",
    "test:architecture-art": "node scripts/browser-regional-architecture.mjs after",
    "geo:nature-art": "node scripts/prepare-nature-art.mjs && DECORATION_EVIDENCE_DIR=work/mission-12C/preparation node scripts/prepare-decorations.mjs",
    "test:nature-art": "node scripts/browser-regional-nature.mjs after",
    "geo:art-dna": "node scripts/prepare-art-dna.mjs && DECORATION_EVIDENCE_DIR=work/mission-12D/preparation node scripts/prepare-decorations.mjs",
    "test:art-dna": "node scripts/verify-art-dna.mjs && node scripts/browser-art-dna-gallery.mjs",
    "geo:relief": "node scripts/prepare-relief-protection.mjs && python scripts/prepare-terrain-refinement.py && node scripts/prepare-relief-surface.mjs",
    "test:relief": "node --test tests/terrain-refinement.test.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "1.65.0",
    "polygon-clipping": "^0.15.7",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
